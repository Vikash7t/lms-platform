# Application Runtime
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Relational Database (Phase 2)
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_platform

# Cryptographic Authentication Secrets (Min 32 characters, distinct keys)
JWT_SECRET=super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_min_32_chars_long

# Cloudinary Media Services (Optional in Phase 1; Required in Phase 7)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payments (Optional in Phase 1; Required in Phase 13)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
